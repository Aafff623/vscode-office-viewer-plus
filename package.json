{
  "name": "vscode-office-viewer-plus",
  "displayName": "Office File Preview Plus",
  "description": "Enhanced Office preview for .docx, .xlsx, .pdf, .pptx with Figma-like Hand Tool pan, smooth zoom and modern UI inside VS Code",
  "version": "1.0.0",
  "publisher": "Aafff623",
  "author": {
    "name": "Aafff623",
    "url": "https://github.com/Aafff623"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aafff623/vscode-office-viewer-plus"
  },
  "bugs": {
    "url": "https://github.com/Aafff623/vscode-office-viewer-plus/issues"
  },
  "homepage": "https://github.com/Aafff623/vscode-office-viewer-plus#readme",
  "icon": "icon.png",
  "keywords": [
    "docx",
    "xlsx",
    "csv",
    "tsv",
    "pdf",
    "pptx",
    "marp",
    "slides",
    "presentation",
    "preview",
    "office",
    "word",
    "excel",
    "powerpoint",
    "viewer"
  ],
  "engines": {
    "vscode": "^1.128.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "officeViewer.docx",
        "displayName": "Office Viewer (Word)",
        "selector": [
          {
            "filenamePattern": "*.docx"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "officeViewer.xlsx",
        "displayName": "Office Viewer (Excel)",
        "selector": [
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.xlsm"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "officeViewer.csv",
        "displayName": "Office File Preview (CSV)",
        "selector": [
          {
            "filenamePattern": "*.csv"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "officeViewer.tsv",
        "displayName": "Office File Preview (TSV)",
        "selector": [
          {
            "filenamePattern": "*.tsv"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "officeViewer.pdf",
        "displayName": "Office Viewer (PDF)",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "officeViewer.pptx",
        "displayName": "Office Viewer (PowerPoint)",
        "selector": [
          {
            "filenamePattern": "*.pptx"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "officeViewer.mermaid",
        "displayName": "Office File Preview (Mermaid)",
        "selector": [
          {
            "filenamePattern": "*.mmd"
          },
          {
            "filenamePattern": "*.mermaid"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "officeViewer.html",
        "displayName": "Office File Preview (HTML)",
        "selector": [
          {
            "filenamePattern": "*.html"
          },
          {
            "filenamePattern": "*.htm"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "officeViewer.markdown",
        "displayName": "Office File Preview (Markdown)",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "officeViewer.marp",
        "displayName": "Office File Preview (Marp Slides)",
        "selector": [
          {
            "filenamePattern": "*.marp.md"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package",
    "publish": "vsce publish",
    "publish:ovsx": "npx ovsx publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.128.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@marp-team/marp-core": "^4.1.1",
    "docx-preview": "^0.3.3",
    "dompurify": "^3.4.15",
    "html2canvas-pro": "^2.4.3",
    "marked": "^18.0.5",
    "mermaid": "^11.15.0",
    "pdfjs-dist": "^4.4.168",
    "pptx-preview": "^1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
